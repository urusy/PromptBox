# ===========================================
# Database
# ===========================================
DB_USER=comfyui
DB_PASSWORD=your_secure_password_here
DB_NAME=comfyui_gallery
# ローカル開発でホストから統合テスト（cargo test）を流すための公開ポート。
# スキーマは backend-rs 起動時に backend-rs/migrations/ が適用する。
# DB_PORT=5433

# ===========================================
# Backend
# ===========================================
# セッション暗号化キー（32文字以上のランダム文字列）
SECRET_KEY=your_secret_key_here_minimum_32_characters

# 管理者認証
ADMIN_USERNAME=admin
# bcryptハッシュ化されたパスワード
# 生成コマンド: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# セッション Cookie の Secure 属性。未設定（推奨）なら X-Forwarded-Proto を見て
# リクエストごとに判定するため、HTTPS（Cloudflare Tunnel 等）と LAN からの
# 平文 HTTP アクセスを同時に成立させられる。
# true/false を書くと固定される（true: HTTPS 専用、false: 常に Secure なし）。
# SESSION_COOKIE_SECURE=

# ===========================================
# Ports
# ===========================================
FRONTEND_PORT=3000
# Rust(axum) backend
BACKEND_RS_PORT=8001
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ===========================================
# Object storage (MinIO)
# 画像の原本・サムネイルは MinIO に保存される（OS権限に依存しない構成）。
# ===========================================
# MinIO の管理者クレデンシャル（backend-rs の S3 アクセスキーとしても使用）。
# パスワードは32文字以上のランダム文字列を推奨。
MINIO_ROOT_USER=promptbox
MINIO_ROOT_PASSWORD=your_minio_password_here_minimum_32_chars
# S3_BUCKET=promptbox
# 切り戻し用: fs にすると backend-rs は STORAGE_PATH のローカルFSを
# （同じ相対パスレイアウトで）読み書きする。通常は s3 のまま。
# STORAGE_BACKEND=s3

# ===========================================
# Import watcher
# 取り込みは backend-rs が所有し、オブジェクトストレージへ保存する。
# ===========================================
# RS_WATCHER_ENABLED=true

# ===========================================
# Import worker (backend-rs)
# ===========================================
# Comma-separated filename substrings excluded from import (case-insensitive).
# Matching files are moved to import/skipped/ instead of being processed.
# Empty by default: grids are imported now (see IMPORT_GRID_PATTERNS). Set this
# to xyz_grid if you would rather not have them in the library at all.
# IMPORT_SKIP_PATTERNS=
# Filename substrings that mark an image as a grid even when its metadata has no
# "Script: X/Y/Z plot". Grids are shown on /grids, not in the normal gallery.
# IMPORT_GRID_PATTERNS=xyz_grid,grid-
# Above this pixel count the thumbnail is generated by streaming PNG scanlines
# instead of decoding the whole image (a full decode needs ~4 bytes per pixel).
# IMPORT_FULL_DECODE_MAX_PIXELS=150000000
# Hard ceiling on pixel count; over this the file goes to import/failed/. Only a
# guard against decoder bombs — streaming keeps memory flat regardless of size.
# IMPORT_MAX_PIXELS=2000000000
# A file that fails to import this many times (content errors only; DB/IO
# outages are not counted) is moved to import/failed/ to stop infinite retries.
# IMPORT_MAX_ATTEMPTS=5

# ===========================================
# Local Network Access (iPhoneなどからアクセスする場合)
# ===========================================
# PCのIPアドレスを指定（例: 192.168.1.100）
# 複数指定する場合はカンマ区切り
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.100:3000

# ===========================================
# Gelbooru API (https://gelbooru.com/index.php?page=account&s=options)
# ===========================================
GELBOORU_API_KEY=
GELBOORU_USER_ID=